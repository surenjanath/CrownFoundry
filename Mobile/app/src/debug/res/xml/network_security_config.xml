<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only.

    Development means a Django runserver on plain HTTP, at whatever address the machine happens
    to have this week: 10.0.2.2 from the emulator, a 192.168.x.x from a phone on the same Wi-Fi,
    a tunnel hostname when someone else is testing. Enumerating those is not possible, so debug
    allows cleartext anywhere and the release config - the one that ships - does not.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
