# ==============================================================================
# CrownFoundry .gitignore
# ==============================================================================

# --- Operating System ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.iml
.project
.settings/
.classpath

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
Backend/.venv/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
*.log
local_settings.py
db.sqlite3-journal
crownfoundry.sqlite3-journal
# The development database itself. Only the journal sidecars were ignored before, which is how
# 23 MB of real match history ended up in a public repository. Production uses DATABASE_URL
# against PostgreSQL; this file is a laptop convenience.
Backend/crownfoundry.sqlite3
Backend/crownfoundry.sqlite3-wal
Backend/crownfoundry.sqlite3-shm

# --- Android & Gradle ---
.gradle/
Mobile/.gradle/
Mobile/.kotlin/
build/
**/build/
bin/
gen/
out/
captures/
.externalNativeBuild/
.cxx/
local.properties
Mobile/local.properties
Mobile/keystore.properties
Mobile/keystore.properties.*

# Signing material never belongs in the repository. release.jks was committed in the initial
# commit and the repository is public, so the key it holds must be treated as disclosed and
# rotated before publishing - removing it from tracking does not remove it from history.
*.jks
*.keystore
Mobile/release.jks
*.hprof

# Android Studio / IntelliJ project files
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Android keystore files. There is no "keep release.jks if committed" case: a signing key in a
# public repository is a disclosed key, and the re-inclusion rule that used to live here is how
# this one got committed in the first place.
*.keystore
*.jks
*.jks.*

# Build outputs. The bundle is produced by a release build, not stored.
*.aab

# Logs & Temporary Files
*.log
/tmp/
dump.xml
dump_test.xml
Backend/var/
Backend/staticfiles/
Backend/.env


# Local agent tooling. Generic skill definitions, nothing to do with this project.
.cursor/
.claude/
.agents/
