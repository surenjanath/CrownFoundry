# CrownFoundry backend — production environment.
# Copy to .env (or set these in your host's dashboard) and fill in. Nothing here has a safe
# default: the settings module refuses to boot in production with the placeholders still in place.

# --- required ---------------------------------------------------------------------------
CROWNFOUNDRY_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(64))"
CROWNFOUNDRY_SECRET_KEY=
# Comma separated. A wildcard is refused when DEBUG is off.
CROWNFOUNDRY_ALLOWED_HOSTS=crownfoundry.example.com
# Guards the dashboard at / and every training endpoint. Generate like the secret key.
CROWNFOUNDRY_DASHBOARD_TOKEN=

# --- strongly recommended ---------------------------------------------------------------
# Needed for the admin and dashboard to accept form posts over HTTPS.
CROWNFOUNDRY_CSRF_TRUSTED_ORIGINS=https://crownfoundry.example.com
# SQLite is fine for one process. Concurrency, backups and a restart that keeps its data are not
# what a file on an ephemeral container gives you.
DATABASE_URL=postgres://user:password@host:5432/crownfoundry

# --- optional ---------------------------------------------------------------------------
# Set to 0 only if your proxy terminates TLS without setting X-Forwarded-Proto.
CROWNFOUNDRY_BEHIND_TLS=1

# Whether offline matches synced from devices train the shared policy. Leave off on a public
# deployment: a sync payload is a client-authored move list, so this is an unauthenticated write
# to the opponent every other player faces.
CROWNFOUNDRY_TRAIN_FROM_SYNC=0

# Background self-play. This is the safe way to keep improving the shared policy, because it is
# gated on beating the previous weights against fixed baselines.
CROWNFOUNDRY_IDLE_SELFPLAY=1
CROWNFOUNDRY_IDLE_INTERVAL_S=180
CROWNFOUNDRY_IDLE_GAMES=8

# Request budgets. The scoped ones below are counted PER PLAYER, so one phone cannot spend a
# whole mobile carrier's budget - carrier-grade NAT puts thousands of handsets on one address.
# CROWNFOUNDRY_RATE_ANON is the per-address ceiling underneath them, and holds when a client
# forges its ids; keep it well above what one person can produce.
CROWNFOUNDRY_RATE_ANON=1200/min
CROWNFOUNDRY_RATE_AI_TURN=60/min
CROWNFOUNDRY_RATE_MATCH_START=30/min
CROWNFOUNDRY_RATE_ENGINE_SYNC=12/hour
CROWNFOUNDRY_RATE_ANALYTICS=60/min

# The AI's voice. Without a reachable Ollama it narrates with the heuristic writer instead.
OLLAMA_ENABLED=0
